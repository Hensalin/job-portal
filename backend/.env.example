# Copy this file to .env and fill in your own values.
# NEVER commit the real .env - it holds a key that bypasses all database security.

# Port the Express API listens on.
PORT=5000

# Supabase project URL.
# CRITICAL: NO trailing slash and NO "/rest/v1" at the end.
#   Correct: https://abcdefgh.supabase.co
#   Wrong:   https://abcdefgh.supabase.co/rest/v1/   <- causes "Invalid path specified in request URL"
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The service_role key. Find it in Supabase dashboard -> Project Settings -> API.
# On the newer dashboard it is called an "API key" and starts with sb_secret_
# This key BYPASSES row level security. Server-side only.
# It must NEVER appear in frontend/ code or any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Which browser origins may call the API. Comma separated, exact matches.
# Why exact: this is a security control, not a convenience feature.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Where Supabase should send users after they click the email verification link.
# Supabase dashboard -> Authentication -> URL Configuration -> Site URL / Redirect URLs
SUPABASE_REDIRECT_URL=http://localhost:5173/login
